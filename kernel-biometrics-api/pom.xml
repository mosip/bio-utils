<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.mosip.biometrics</groupId>
		<artifactId>biometrics</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>io.mosip.kernel</groupId>
	<artifactId>kernel-biometrics-api</artifactId>
	<packaging>jar</packaging>
	<name>kernel-biometrics-api</name>
	<description>
		Biometric SPI contracts and data model for MOSIP: IBioApi / IBioApiV2, CbeffUtil,
		BIR / BiometricRecord entities, modality constants, and CBEFF validation helpers.
		Published library JAR; prefer IBioApiV2.convertFormatV2 over deprecated convertFormat.
	</description>
	<url>https://github.com/mosip/bio-utils</url>

	<!-- Inherits version properties and plugins from biometrics. Do not reintroduce kernel-bom. -->
	<properties>
		<sonar.coverage.exclusions>
			**/constant/**,**/config/**,**/httpfilter/**,**/cache/**,**/dto/**,**/entity/**,**/model/**,**/exception/**,**/repository/**,**/security/**,**/*Config.java,**/*BootApplication.java,**/cbeffutil/**
		</sonar.coverage.exclusions>
	</properties>

	<dependencies>
		<!--
			kernel-core: Base MOSIP types, exceptions, and logger factory used by SPI / CbeffValidator.
			Version ${kernel.core.version}. MPL-2.0. Do not pull kernel-bom or kernel-logger-logback.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			spring-boot-jackson2: Boot 4 ships Jackson 3 by default; this keeps Jackson 2 for
			ByteArrayToIntArraySerializer / IntArrayToByteArrayDeserializer and date adapters.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>
		<!--
			jackson-databind: JsonGenerator / ObjectMapper for biometric field serializers and BIR JSON.
			Version from Boot jackson2 line. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!--
			gson: GSONByteArrayAdapter and related entity adapters for byte[] ↔ Base64/JSON.
			Version ${gson.version}. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<!--
			jaxb-api (javax 2.3.x): JAXB annotations on BIR / ObjectFactory for CBEFF XML.
			Stay on javax — Jakarta JAXB 4.x is incompatible with current CBEFF code.
			License: CDDL-1.1 (elected) OR GPL-2.0-with-CPE.
		-->
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
		</dependency>
		<!--
			jaxb-runtime: JAXB 2.3 RI for marshalling/unmarshalling CBEFF BIR XML at runtime.
			Version ${jaxb.runtime.version}. License: EDL-1.0 / BSD-2-Clause.
		-->
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
		</dependency>
	</dependencies>
</project>
