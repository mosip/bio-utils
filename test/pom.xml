<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Sample CLI apps only — not in the reactor modules list. Do not reintroduce kernel-bom. -->
	<parent>
		<groupId>io.mosip.biometrics</groupId>
		<artifactId>biometrics</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>io.mosip.bio.utils</groupId>
	<artifactId>bioutils</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>biometrics-util-test</name>
	<description>
		Sample CLI applications demonstrating biometrics-util (ISO decode/encode, image-type
		conversion, NIST file reader). Not a published Maven Central artifact.
	</description>
	<url>https://github.com/mosip/bio-utils</url>

	<dependencies>
		<!--
			biometrics-util: Library under demo — Finger/Iris/FaceEncoder-Decoder, CommonUtil, NIST.
			Version from parent (${mosip.biometrics.util.version}). MPL-2.0.
		-->
		<dependency>
			<groupId>io.mosip.biometric.util</groupId>
			<artifactId>biometrics-util</artifactId>
		</dependency>
		<!--
			spring-boot-starter-web: Optional Spring context for sample apps that need Boot wiring.
			Version from Boot parent 4.1.1. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			spring-boot-jackson2: Jackson 2 under Boot 4 for sample JSON/XML tooling.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>
		<!--
			kernel-core: Shared MOSIP helpers used by sample CLIs. ${kernel.core.version}. MPL-2.0.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			okhttp (2.x): HTTP client for NistDataQualityAnalyser → external BQAT service.
			Version ${okhttp.version}. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.squareup.okhttp</groupId>
			<artifactId>okhttp</artifactId>
		</dependency>
		<!--
			jackson-databind: JSON for sample auth/crypto payloads and BQAT responses.
			License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!--
			jackson-dataformat-csv: Write NIST quality analysis results to CSV.
			Version from Boot parent. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-csv</artifactId>
		</dependency>
		<!--
			commons-lang3: String utilities in sample apps. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<!--
			protobuf-java: Same as biometrics-util (transitive alignment / direct use in samples).
			Version ${google.protobuf.version}. License: BSD-3-Clause.
		-->
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
		</dependency>
		<!--
			jai-imageio-jpeg2000: JP2 handling in BioUtilApplication / convert demos.
			Version ${jai.imageio.jpeg2000.version}. License: BSD-3-Clause-No-Nuclear.
		-->
		<dependency>
			<groupId>com.github.jai-imageio</groupId>
			<artifactId>jai-imageio-jpeg2000</artifactId>
		</dependency>
		<!--
			jnbis: WSQ demos for finger ISO encode/decode samples.
			Version ${github.mhshams.jnbis.version}. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.github.mhshams</groupId>
			<artifactId>jnbis</artifactId>
		</dependency>
		<!--
			imgscalr-lib: Optional image resize in sample pipelines.
			Version ${imgscalr.lib.version}. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.imgscalr</groupId>
			<artifactId>imgscalr-lib</artifactId>
		</dependency>
		<!--
			opencv: Same OpenCV helpers as biometrics-util for sample convert CLIs.
			Version ${openpnp.opencv.version}. License: BSD-3-Clause.
		-->
		<dependency>
			<groupId>org.openpnp</groupId>
			<artifactId>opencv</artifactId>
		</dependency>
	</dependencies>
</project>
