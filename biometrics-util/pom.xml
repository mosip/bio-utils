<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.mosip.biometrics</groupId>
		<artifactId>biometrics</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>io.mosip.biometric.util</groupId>
	<artifactId>biometrics-util</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>biometrics-util</name>
	<description>
		Standalone ISO biometric format converters (no Spring): ISO/IEC 19794-4:2011 Finger,
		19794-5:2011 Face, 19794-6:2011 Iris encode/decode to JPEG/PNG/BufferedImage; NIST ITL
		1-2011 XML parser; JPEG2000 (jai-imageio), WSQ decode (jnbis) / encode (NIST NBIS port), and OpenCV helpers.
	</description>
	<url>https://github.com/mosip/bio-utils</url>

	<!-- Inherits version properties and plugins from biometrics. Do not reintroduce kernel-bom. -->
	<properties>
		<sonar.coverage.exclusions>
			**/constant/**,**/exception/**
		</sonar.coverage.exclusions>
	</properties>

	<dependencies>
		<!--
			kernel-core: MOSIP exceptions / logging facades used by converters.
			Version from parent dependencyManagement (${kernel.core.version}). MPL-2.0.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			slf4j-api: Logging API for ISO header/body parsers (LOGGER.error on undefined codes).
			Version from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!--
			commons-lang3: String/object helpers in CommonUtil and validation paths.
			Version from Boot parent. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<!--
			protobuf-java: Protocol Buffer runtime for biometric util binary helpers.
			Version ${google.protobuf.version}. License: BSD-3-Clause.
		-->
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
		</dependency>
		<!--
			jai-imageio-jpeg2000: Read/write JPEG2000 image bytes inside ISO 19794 containers
			(Face/Iris/Finger JP2 ↔ JPEG/PNG). Version ${jai.imageio.jpeg2000.version}.
			License: BSD-3-Clause-No-Nuclear.
		-->
		<dependency>
			<groupId>com.github.jai-imageio</groupId>
			<artifactId>jai-imageio-jpeg2000</artifactId>
		</dependency>
		<!--
			jnbis: WSQ decoder/encoder for finger AUTH ISO payloads (FingerImageCompressionType.WSQ).
			Version ${github.mhshams.jnbis.version}. License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.github.mhshams</groupId>
			<artifactId>jnbis</artifactId>
		</dependency>
		<!--
			spring-boot-jackson2: Boot 4 defaults to Jackson 3; this module keeps Jackson 2 for
			NIST XML XmlMapper and existing ObjectMapper usage. Version from Boot parent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>
		<!--
			jackson-databind: Core ObjectMapper / JSON tree for ConvertRequestDto and helpers.
			Version from Boot (via jackson2). License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!--
			jackson-dataformat-xml: XmlMapper for NIST ITL 1-2011 XML parse/serialize
			(CommonUtil.nistParser / nistXml, NamespaceXmlFactory). License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-xml</artifactId>
		</dependency>
		<!--
			jackson-module-jaxb-annotations: JAXB annotation support on Jackson XML for NIST models.
			License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.module</groupId>
			<artifactId>jackson-module-jaxb-annotations</artifactId>
		</dependency>
		<!--
			opencv (openpnp): Mat-based JP2↔JPEG/PNG/WEBP conversion (CommonUtil.convertJP2*UsingOpenCV).
			Version ${openpnp.opencv.version}. License: BSD-3-Clause.
		-->
		<dependency>
			<groupId>org.openpnp</groupId>
			<artifactId>opencv</artifactId>
		</dependency>
		<!--
			hibernate-validator: Bean Validation API for request DTOs where annotated.
			Version from Boot parent. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
		</dependency>
		<!--
			mockito-core: Unit-test mocks (static CommonUtil, JsonGenerator, etc.). Scope: test.
			Version from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
