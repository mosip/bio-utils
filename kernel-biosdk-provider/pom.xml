<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.mosip.biometrics</groupId>
		<artifactId>biometrics</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>io.mosip.kernel</groupId>
	<artifactId>kernel-biosdk-provider</artifactId>
	<packaging>jar</packaging>
	<name>kernel-biosdk-provider</name>
	<description>
		Reflection-based bridge from MOSIP to vendor biometric SDKs (BioProviderImpl V0.7–V0.9).
		No compile-time dependency on vendor JARs — SDK class names come from
		mosip.biometric.sdk.providers.* configuration. Logger APIs come from kernel-core
		(not a separate kernel-logger-logback artifact).
	</description>
	<url>https://github.com/mosip/bio-utils</url>

	<!-- Inherits version properties and plugins from biometrics. Do not reintroduce kernel-bom. -->
	<dependencies>
		<!--
			spring-boot-starter-web: Spring MVC / embedded Tomcat for BioAPIFactory auto-config
			and provider beans in host MOSIP services. Version from Boot parent 4.1.1.
			License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			spring-boot-jackson2: Keep Jackson 2 for MOSIP biometric JSON payloads under Boot 4
			(Boot default Jackson 3 would break existing serializers). License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>
		<!--
			spring-boot-starter-data-jpa: JPA / Hibernate stack for optional persistence hooks
			in BioSDK provider deployments. Version from Boot parent. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
			h2: Embedded DB for local/dev provider tests and demos.
			Dual-license EPL-1.0 OR MPL-2.0 — MOSIP elects MPL-2.0. Version from Boot parent.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>
		<!--
			kernel-core: Logger factory, exceptions, shared utilities for BioProviderImpl.
			Version ${kernel.core.version}. MPL-2.0. No kernel-logger-logback artifact.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			kernel-biometrics-api: IBioApi / IBioApiV2 contracts, BIR conversion (BIRConverter),
			QualityCheck / MatchDecision models implemented or wrapped by BioProviderImpl.
			Sibling — omit <version> in reactor builds.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-biometrics-api</artifactId>
		</dependency>
	</dependencies>
</project>
